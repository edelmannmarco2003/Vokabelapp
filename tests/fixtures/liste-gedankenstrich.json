[[{"str":"Vokabeln Lektion 5","x":60,"y":51.89,"w":145.82,"h":16,"font":"g_d3_f2"},{"str":"","x":60,"y":91.89,"w":0,"h":12,"font":"g_d3_f1"},{"str":"1. house – das Haus","x":60,"y":91.89,"w":110.06,"h":12,"font":"g_d3_f1"},{"str":"2. to go – gehen","x":60,"y":109.89,"w":86.74,"h":12,"font":"g_d3_f1"},{"str":"3. tree – der Baum","x":60,"y":127.89,"w":99.38,"h":12,"font":"g_d3_f1"},{"str":"4. to look forward to something – sich auf etwas freuen","x":60,"y":145.89,"w":290.81,"h":12,"font":"g_d3_f1"},{"str":"5. although – obwohl","x":60,"y":163.89,"w":110.74,"h":12,"font":"g_d3_f1"},{"str":"6. neighbour – der Nachbar, die Nachbarin","x":60,"y":181.89,"w":226.78,"h":12,"font":"g_d3_f1"},{"str":"7. to be able to do something even though it is difficult – etwas tun können, obwohl es schwierig ist","x":60,"y":199.89,"w":522.94,"h":12,"font":"g_d3_f1"},{"str":"8. knowledge – das Wissen","x":60,"y":217.89,"w":146.06,"h":12,"font":"g_d3_f1"},{"str":"9. environment – die Umwelt","x":60,"y":235.89,"w":152.05,"h":12,"font":"g_d3_f1"},{"str":"10. to borrow – sich etwas ausleihen","x":60,"y":253.89,"w":194.09,"h":12,"font":"g_d3_f1"},{"str":"11. thunderstorm – das Gewitter","x":60,"y":271.89,"w":171.41,"h":12,"font":"g_d3_f1"},{"str":"12. actually – eigentlich, tatsächlich","x":60,"y":289.89,"w":188.09,"h":12,"font":"g_d3_f1"},{"str":"13. to become – werden","x":60,"y":307.89,"w":128.74,"h":12,"font":"g_d3_f1"},{"str":"14. pollution – die Umweltverschmutzung","x":60,"y":325.89,"w":218.75,"h":12,"font":"g_d3_f1"},{"str":"15. to improve – verbessern","x":60,"y":343.89,"w":148.73,"h":12,"font":"g_d3_f1"},{"str":"16. advice – der Rat, der Ratschlag","x":60,"y":361.89,"w":188.09,"h":12,"font":"g_d3_f1"},{"str":"17. to apologize – sich entschuldigen","x":60,"y":379.89,"w":196.78,"h":12,"font":"g_d3_f1"},{"str":"18. challenge – die Herausforderung","x":60,"y":397.89,"w":194.1,"h":12,"font":"g_d3_f1"},{"str":"19. to decide – sich entscheiden","x":60,"y":415.89,"w":171.43,"h":12,"font":"g_d